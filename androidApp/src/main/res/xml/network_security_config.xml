<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext. Companion TLS is pinned in code (leaf SHA-256), not via a
     user-added CA. System CAs stay as the default for any other host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
